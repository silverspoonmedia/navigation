{
    "name": "silverspoonmedia/navigation",
    "description": "Silverspoon core domain package: RBAC + domain-access aware navigation menus.",
    "type": "library",
    "license": "proprietary",
    "version": "1.0.2",
    "homepage": "https://github.com/silverspoonmedia/navigation",
    "support": {
        "source": "https://github.com/silverspoonmedia/navigation"
    },
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0",
        "silverspoonmedia/platform": "^1.0",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-translatable": "^6.14"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\Domain\\Navigation\\": "src/",
            "App\\Domain\\Navigation\\Database\\Factories\\": "database/factories/",
            "App\\Domain\\Navigation\\Database\\Seeders\\": "database/seeders/",
            "App\\Domain\\Navigation\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php vendor/bin/phpunit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "App\\Domain\\Navigation\\NavigationServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
